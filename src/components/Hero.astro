---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">

  <!-- Background image + overlay -->
  <div class="absolute inset-0">
    <img
      src="https://assets.cdn.filesafe.space/jGKx4eTTbP1enXZEBWxm/media/c8cdce29-f8ad-4d4a-adc7-22eb597d2e46.jpg"
      alt="Professional commercial cleaning in Cleveland OH"
      class="w-full h-full object-cover object-center"
      loading="eager"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(145deg, rgba(15,24,39,0.92) 0%, rgba(26,39,68,0.82) 60%, rgba(15,24,39,0.88) 100%);"
    ></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto pt-28 pb-16">

    <!-- Headline — word-by-word animation -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-black text-white mb-6 leading-tight tracking-tight">
      <span class="hero-word" style="animation-delay: 0.15s">Spotless</span>&nbsp;<span
        class="hero-word" style="animation-delay: 0.28s">Spaces,</span>
      <br />
      <span class="hero-word text-blue-400" style="animation-delay: 0.44s">Superior</span>&nbsp;<span
        class="hero-word" style="animation-delay: 0.57s">Service</span>
    </h1>

    <!-- Sub-headline -->
    <p
      class="hero-subtext text-xl md:text-2xl text-gray-300 mb-3 font-medium"
      style="animation-delay: 0.9s"
    >
      Cleaning services you can see and feel
    </p>

    <!-- Body copy -->
    <p
      class="hero-subtext text-base md:text-lg text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed"
      style="animation-delay: 1.1s"
    >
      Your business space is more than just a building — it's a reflection of your professionalism.
      Flex Commercial Services brings top-tier commercial cleaning to Cleveland and all of Northeast Ohio.
    </p>

    <!-- CTA buttons -->
    <div
      class="hero-subtext flex flex-col sm:flex-row items-center justify-center gap-4"
      style="animation-delay: 1.3s"
    >
      <a href="/booking" class="btn-primary cta-pulse text-base px-9 py-4 rounded-lg">
        Get a Free Quote
      </a>
      <a href="/services" class="btn-outline text-base px-9 py-4 rounded-lg">
        See Our Services
      </a>
    </div>

    <!-- Phone -->
    <div class="hero-subtext mt-7" style="animation-delay: 1.5s">
      <a
        href="tel:2168019686"
        class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors duration-200 text-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        (216)-801-9686
      </a>
    </div>

  </div>

  <!-- Scroll indicator -->
  <div class="scroll-bounce absolute bottom-8 left-1/2" style="transform: translateX(-50%);">
    <svg class="w-7 h-7 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>

</section>
