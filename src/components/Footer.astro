---
const currentYear = new Date().getFullYear();
---

<footer class="footer-border-animate animate-on-scroll fade-up bg-brand-navy pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Logo centered -->
    <div class="text-center mb-12">
      <img
        src="/images/logo.png"
        alt="Flex Commercial Services"
        width="281"
        height="176"
        class="h-20 w-auto mx-auto mb-4"
        loading="lazy"
      />
      <p class="text-brand-muted text-sm max-w-md mx-auto">
        Cleveland's trusted commercial cleaning experts, delivering spotless results across Northeast Ohio.
      </p>
    </div>

    <!-- 3-column grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">

      <!-- Quick Links -->
      <div class="animate-on-scroll fade-up stagger-1">
        <h3 class="text-white font-bold text-base uppercase tracking-widest mb-5">Quick Links</h3>
        <ul class="space-y-3">
          <li><a href="/"         class="text-brand-muted hover:text-white transition-colors duration-200 text-sm">Home</a></li>
          <li><a href="/about"    class="text-brand-muted hover:text-white transition-colors duration-200 text-sm">About</a></li>
          <li><a href="/services" class="text-brand-muted hover:text-white transition-colors duration-200 text-sm">Services</a></li>
          <li><a href="/booking"  class="text-brand-muted hover:text-white transition-colors duration-200 text-sm">Booking</a></li>
          <li><a href="/faq"      class="text-brand-muted hover:text-white transition-colors duration-200 text-sm">FAQ</a></li>
        </ul>
      </div>

      <!-- Contact Us -->
      <div class="animate-on-scroll fade-up stagger-2">
        <h3 class="text-white font-bold text-base uppercase tracking-widest mb-5">Contact Us</h3>
        <ul class="space-y-3 text-sm">
          <li class="text-brand-muted">Cleveland, OH 44102</li>
          <li>
            <a href="tel:2168019686" class="text-brand-muted hover:text-white transition-colors duration-200">
              (216)-801-9686
            </a>
          </li>
          <li>
            <a href="mailto:teamflexcommercialservices@gmail.com" class="text-brand-muted hover:text-white transition-colors duration-200 break-all">
              teamflexcommercialservices@gmail.com
            </a>
          </li>
        </ul>
      </div>

      <!-- Follow Us -->
      <div class="animate-on-scroll fade-up stagger-3">
        <h3 class="text-white font-bold text-base uppercase tracking-widest mb-5">Follow Us</h3>
        <a
          href="https://www.instagram.com/teamflexservices"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-brand-muted hover:text-white transition-colors duration-200 text-sm group"
        >
          <svg class="w-5 h-5 flex-shrink-0 group-hover:text-pink-400 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @teamflexservices
        </a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-6 text-center">
      <p class="text-brand-muted text-sm">
        © Flex Commercial Services {currentYear}. All Rights Reserved.
      </p>
    </div>

  </div>
</footer>
