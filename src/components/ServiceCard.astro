---
interface Props {
  title: string;
  image: string;
  delay?: number;
}

const { title, image, delay = 0 } = Astro.props;
---

<a
  href="/services#choose-your-plan"
  class="service-card animate-on-scroll scale-in block"
  style={`transition-delay: ${delay}s`}
>
  <!-- Image card with dark overlay + title -->
  <div class="relative rounded-2xl overflow-hidden" style="min-height: 280px;">
    <img
      src={`${image}?w=800&q=80&fit=crop&auto=format`}
      alt={title}
      width="800"
      height="533"
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="lazy"
    />

    <!-- Dark overlay -->
    <div
      class="absolute inset-0"
      style="background-color: rgba(0, 0, 0, 0.75);"
    ></div>

    <!-- Title centered in the middle of the image -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center text-center"
      style="height: 100%; padding: 1.5rem;"
    >
      <h3 class="text-white font-bold text-xl leading-snug drop-shadow-lg">
        {title}
      </h3>
    </div>
  </div>
</a>
