---
interface Props {
  title: string;
  image: string;
  delay?: number;
}

const { title, image, delay = 0 } = Astro.props;
---

<div
  class="service-card animate-on-scroll scale-in flex flex-col gap-3"
  style={`transition-delay: ${delay}s`}
>
  <!-- Image card with dark navy overlay + title -->
  <div class="relative rounded-2xl overflow-hidden" style="min-height: 280px;">
    <img
      src={`${image}?w=800&q=80&fit=crop&auto=format`}
      alt={title}
      class="absolute inset-0 w-full h-full object-cover object-center"
      loading="lazy"
    />

    <!-- Dark navy overlay -->
    <div
      class="absolute inset-0"
      style="background-color: rgba(10, 20, 50, 0.75);"
    ></div>

    <!-- Title centred in the middle of the image -->
    <div
      class="absolute inset-0 flex flex-col items-center justify-center text-center"
      style="height: 100%; padding: 1.5rem;"
    >
      <h3 class="text-white font-bold text-xl leading-snug drop-shadow-lg">
        {title}
      </h3>
    </div>
  </div>

  <!-- CTA links below the card -->
  <div class="flex items-center justify-center gap-6">
    <a
      href="/services"
      class="text-sm text-blue-400 hover:text-blue-300 font-semibold transition-colors duration-200"
    >
      Service Details →
    </a>
    <a
      href="/booking"
      class="text-sm text-blue-400 hover:text-blue-300 font-semibold transition-colors duration-200"
    >
      Book a Service →
    </a>
  </div>
</div>
