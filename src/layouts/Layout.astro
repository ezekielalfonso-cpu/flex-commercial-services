---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  /** Extra JSON-LD nodes (e.g. Service, ContactPage) merged into the page's @graph, alongside the sitewide LocalBusiness entity. */
  additionalSchema?: object[];
  /** Short label for this page in the breadcrumb trail (e.g. "About"). Omit on the homepage — no breadcrumb is emitted there. */
  breadcrumbLabel?: string;
}

const siteURL = import.meta.env.SITE ?? 'https://flexcommercialservices.com';

const {
  title,
  description,
  canonicalURL = new URL(Astro.url.pathname, siteURL).href,
  ogImage = 'https://assets.cdn.filesafe.space/jGKx4eTTbP1enXZEBWxm/media/68124cf13176b90a9f675eb4.png',
  additionalSchema = [],
  breadcrumbLabel
} = Astro.props;

const breadcrumbSchema = breadcrumbLabel
  ? {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL },
        { "@type": "ListItem", "position": 2, "name": breadcrumbLabel, "item": canonicalURL }
      ]
    }
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Flex Commercial Services" />

  <!-- Geo Tags -->
  <meta name="geo.region" content="US-OH" />
  <meta name="geo.placename" content="Cleveland, Ohio" />
  <meta name="geo.position" content="41.4993;-81.6944" />

  <!-- LocalBusiness Structured Data (+ page-specific nodes via additionalSchema) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["LocalBusiness", "ProfessionalService"],
        "@id": "https://flexcommercialservices.com/#business",
        "name": "Flex Commercial Services",
        "description": "Professional commercial cleaning company serving Cleveland and Northeast Ohio. Specializing in janitorial services, medical sanitization, and post-event cleanup.",
        "url": "https://flexcommercialservices.com",
        "telephone": "+1-216-801-9686",
        "email": "teamflexcommercialservices@gmail.com",
        "image": "https://assets.cdn.filesafe.space/jGKx4eTTbP1enXZEBWxm/media/68124cf13176b90a9f675eb4.png",
        "priceRange": "Custom quote",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cleveland",
          "addressRegion": "OH",
          "postalCode": "44102",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.4993,
          "longitude": -81.6944
        },
        "areaServed": [
          { "@type": "City", "name": "Cleveland" },
          { "@type": "City", "name": "Lakewood" },
          { "@type": "City", "name": "Parma" },
          { "@type": "City", "name": "Strongsville" },
          { "@type": "City", "name": "Beachwood" },
          { "@type": "City", "name": "Solon" }
        ],
        "sameAs": [
          "https://www.instagram.com/teamflexservices"
        ]
      },
      {
        "@type": "WebSite",
        "@id": `${siteURL}/#website`,
        "url": siteURL,
        "name": "Flex Commercial Services",
        "publisher": { "@id": "https://flexcommercialservices.com/#business" }
      },
      ...(breadcrumbSchema ? [breadcrumbSchema] : []),
      ...additionalSchema
    ]
  })} />

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="https://assets.cdn.filesafe.space/jGKx4eTTbP1enXZEBWxm/media/68124cf13176b90a9f675eb4.png"
  />

  <!-- CDN preconnect -->
  <link rel="preconnect" href="https://assets.cdn.filesafe.space" />

  <!-- Google Fonts: Playfair Display (headings) + Mulish (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Mulish:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style is:global>
    body {
      font-family: 'Mulish', system-ui, sans-serif;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Playfair Display', Georgia, serif;
    }
  </style>

  <!-- GA4: Replace this comment with your GA4 script tag -->
</head>
<body>
  <slot />
</body>
</html>
