---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
---

<Layout
  title="Get a Free Quote | Flex Commercial Services Cleveland, OH"
  description="Request a free commercial cleaning quote from Flex Commercial Services. Serving Cleveland and Northeast Ohio businesses."
  breadcrumbLabel="Booking"
  additionalSchema={[
    {
      "@type": "ContactPage",
      "@id": "https://flexcommercialservices.com/booking/#contact",
      "name": "Book Commercial Cleaning in Cleveland, OH",
      "url": "https://flexcommercialservices.com/booking",
      "mainEntity": { "@id": "https://flexcommercialservices.com/#business" },
    },
  ]}
>
  <Navbar />

  <!-- ── PAGE HERO ──────────────────────────────────────────────────────── -->
  <section
    class="pt-36 pb-16 text-center"
    style="background: linear-gradient(145deg, #0a0a0a 0%, #141414 50%, #0a0a0a 100%);"
  >
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="animate-on-scroll fade-up text-4xl sm:text-5xl md:text-6xl font-black text-white mb-5 leading-tight">
        Book Commercial Cleaning<br />
        <span class="text-brand-accent-dark">in Cleveland, OH</span>
      </h1>
      <p class="animate-on-scroll fade-up stagger-1 text-brand-muted text-lg leading-relaxed mb-4">
        Embrace the simplicity of a clean, organized space without lifting a finger.
      </p>
      <p class="animate-on-scroll fade-up stagger-2 text-brand-muted leading-relaxed">
        Booking is easy, efficient, and tailored to fit your schedule and needs.
        Start your journey to a pristine space today, just a few steps away!
      </p>
    </div>
  </section>

  <!-- ── BOOKING FORM + CONTACT ─────────────────────────────────────────── -->
  <section class="py-20 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <!-- Left: form -->
        <div class="animate-on-scroll fade-left">
          <div class="bg-brand-navy border border-[#2e2e2e] rounded-2xl p-8 md:p-10">
            <h2 class="text-2xl font-black text-white mb-2">Get Your Free Quote</h2>
            <p class="text-brand-muted text-sm mb-8">
              Fill out the form to receive a <strong class="text-white">free</strong> personalized quote. We'll respond within 24 hours.
            </p>

            <form
              id="booking-form"
              class="flex flex-col gap-5"
              novalidate
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="first-name" class="block text-sm font-medium text-gray-300 mb-1.5">First Name *</label>
                  <input
                    type="text"
                    id="first-name"
                    name="first_name"
                    required
                    autocomplete="given-name"
                    class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                    placeholder="Jane"
                  />
                </div>
                <div>
                  <label for="last-name" class="block text-sm font-medium text-gray-300 mb-1.5">Last Name *</label>
                  <input
                    type="text"
                    id="last-name"
                    name="last_name"
                    required
                    autocomplete="family-name"
                    class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                    placeholder="Smith"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Email Address *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                  placeholder="jane@yourbusiness.com"
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-300 mb-1.5">Phone Number *</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  autocomplete="tel"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                  placeholder="(216) 555-0100"
                />
              </div>

              <div>
                <label for="business" class="block text-sm font-medium text-gray-300 mb-1.5">Business Name</label>
                <input
                  type="text"
                  id="business"
                  name="business_name"
                  autocomplete="organization"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                  placeholder="Your Business LLC"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="service-type" class="block text-sm font-medium text-gray-300 mb-1.5">Service Type</label>
                  <select
                    id="service-type"
                    name="service_type"
                    class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                  >
                    <option value="">Select a service...</option>
                    <option value="restaurant">Restaurant Cleaning</option>
                    <option value="office">Office Cleaning</option>
                    <option value="fitness">Fitness Center Cleaning</option>
                    <option value="school">School / Daycare Cleaning</option>
                    <option value="medical">Medical Facility Cleaning</option>
                    <option value="move">Move-In / Move-Out Cleaning</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div>
                  <label for="square-footage" class="block text-sm font-medium text-gray-300 mb-1.5">Approximate Square Footage *</label>
                  <input
                    type="number"
                    id="square-footage"
                    name="square_footage"
                    required
                    min="1"
                    inputmode="numeric"
                    autocomplete="off"
                    class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                    placeholder="e.g. 2500"
                  />
                </div>
              </div>

              <div>
                <label for="cleaning-frequency" class="block text-sm font-medium text-gray-300 mb-1.5">How often would you like your facility cleaned?</label>
                <select
                  id="cleaning-frequency"
                  name="cleaning_frequency"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                >
                  <option value="">Select a frequency...</option>
                  <option value="one-time">One Time Clean</option>
                  <option value="multiple-times-week">Multiple Times a Week</option>
                  <option value="weekly">Weekly</option>
                  <option value="biweekly">Biweekly</option>
                  <option value="monthly">Monthly</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div id="cleaning-frequency-other-wrap" class="hidden">
                <label for="cleaning-frequency-other" class="block text-sm font-medium text-gray-300 mb-1.5">Cleaning Frequency Details *</label>
                <input
                  type="text"
                  id="cleaning-frequency-other"
                  name="cleaning_frequency_other"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm"
                  placeholder="Tell us what schedule you need..."
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-300 mb-1.5">Tell Us About Your Space</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors text-sm resize-none"
                  placeholder="Frequency, special requirements, areas of focus..."
                ></textarea>
              </div>

              <!--
                NOTE: `square_footage` and `space_photos` are new fields. The form
                submission handler below is still a placeholder (see TODO), and once
                this is wired up to the real GoHighLevel embed, these two fields will
                need to be mapped to their corresponding GHL custom field IDs.
                Not guessing those IDs here — set them when the embed is configured.
              -->
              <div>
                <label for="space-photos" class="block text-sm font-medium text-gray-300 mb-1.5">
                  Upload Photos of the Space <span class="text-brand-muted font-normal">(optional, up to 5 images, 5 MB each)</span>
                </label>
                <input
                  type="file"
                  id="space-photos"
                  name="space_photos"
                  accept="image/*"
                  multiple
                  class="w-full bg-[#1A1A1A] border border-[#2e2e2e] rounded-lg px-4 py-3 text-white text-sm cursor-pointer file:mr-4 file:py-1.5 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-brand-accent file:text-white hover:file:bg-brand-accent-dark file:cursor-pointer focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent transition-colors"
                />
              </div>

              <button
                type="submit"
                class="btn-primary cta-pulse w-full text-center py-4 text-base font-bold rounded-lg"
              >
                Send My Free Quote Request
              </button>

              <p class="text-brand-muted text-xs text-center">
                By submitting you agree to be contacted by Flex Commercial Services regarding your cleaning inquiry.
              </p>

              <p id="form-error" class="hidden text-sm text-red-300 bg-red-500/10 border border-red-500/30 rounded-lg px-4 py-3"></p>
            </form>

            <!-- Success message (hidden by default) -->
            <div id="form-success" class="hidden text-center py-10">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-green-400/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <h3 class="text-white font-bold text-xl mb-2">Request Sent!</h3>
              <p class="text-brand-muted text-sm">We'll be in touch within 24 hours with your personalized quote.</p>
            </div>
          </div>
        </div>

        <!-- Right: contact info + image -->
        <div class="animate-on-scroll fade-right flex flex-col gap-8">

          <div>
            <h2 class="text-2xl font-black text-white mb-6">Let's Get Connected</h2>

            <div class="flex flex-col gap-5">
              <a href="tel:2168019686" class="flex items-center gap-4 group">
                <div class="w-12 h-12 bg-brand-accent rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-brand-accent-dark transition-colors">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-brand-muted uppercase tracking-widest mb-0.5">Call Us</p>
                  <p class="text-white font-bold group-hover:text-brand-accent-dark transition-colors">(216)-801-9686</p>
                </div>
              </a>

              <a href="mailto:teamflexcommercialservices@gmail.com" class="flex items-center gap-4 group">
                <div class="w-12 h-12 bg-brand-accent rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-brand-accent-dark transition-colors">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-brand-muted uppercase tracking-widest mb-0.5">Email Us</p>
                  <p class="text-white font-bold group-hover:text-brand-accent-dark transition-colors text-sm break-all">teamflexcommercialservices@gmail.com</p>
                </div>
              </a>

              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-brand-navy border border-[#2e2e2e] rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-brand-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-brand-muted uppercase tracking-widest mb-0.5">Service Area</p>
                  <p class="text-white font-bold text-sm">Cleveland, OH &amp; Northeast Ohio</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Why us quick list -->
          <div class="bg-brand-navy border border-[#2e2e2e] rounded-2xl p-7">
            <h3 class="text-white font-bold mb-4">Why Flex?</h3>
            <ul class="flex flex-col gap-3 text-sm text-brand-muted">
              {[
                'Free, no-obligation quote within 24 hours',
                'Fully insured and bonded for your protection',
                'Month-to-month or contract pricing, your choice',
                'Professional-grade equipment &amp; supplies provided',
                'Dedicated point of contact for every account',
                'Serving Cleveland and Northeast Ohio since day one',
              ].map(item => (
                <li class="flex items-start gap-2.5">
                  <svg class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span set:html={item} />
                </li>
              ))}
            </ul>
          </div>

        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollAnimations />
</Layout>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const cleaningFrequency = document.getElementById('cleaning-frequency') as HTMLSelectElement | null;
  const cleaningFrequencyOtherWrap = document.getElementById('cleaning-frequency-other-wrap');
  const cleaningFrequencyOther = document.getElementById('cleaning-frequency-other') as HTMLInputElement | null;

  const toggleCleaningFrequencyOther = () => {
    const isOther = cleaningFrequency?.value === 'other';
    cleaningFrequencyOtherWrap?.classList.toggle('hidden', !isOther);

    if (cleaningFrequencyOther) {
      cleaningFrequencyOther.required = isOther;
      if (!isOther) cleaningFrequencyOther.value = '';
    }
  };

  cleaningFrequency?.addEventListener('change', toggleCleaningFrequencyOther);
  toggleCleaningFrequencyOther();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (errorMsg) {
      errorMsg.textContent = '';
      errorMsg.classList.add('hidden');
    }

    const originalButtonText = submitButton?.textContent || 'Send My Free Quote Request';

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending...';
    }

    try {
      const response = await fetch('/.netlify/functions/booking', {
        method: 'POST',
        body: new FormData(form),
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'Something went wrong. Please try again.');
      }

      form.style.display = 'none';
      if (successMsg) successMsg.classList.remove('hidden');
    } catch (error) {
      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
        errorMsg.classList.remove('hidden');
      }
    } finally {
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = originalButtonText;
      }
    }
  });
</script>
