---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';

const services = [
  {
    title: 'Restaurant Cleaning',
    image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4',
    delay: 0,
  },
  {
    title: 'Office Cleaning',
    image: 'https://images.unsplash.com/photo-1497366216548-37526070297c',
    delay: 0.15,
  },
  {
    title: 'Fitness Center Cleaning',
    image: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48',
    delay: 0.30,
  },
  {
    title: 'School / Daycare Cleaning',
    image: 'https://images.unsplash.com/photo-1763310225230-6e15b125935a',
    delay: 0.45,
  },
  {
    title: 'Move-In / Move-Out Cleaning',
    image: 'https://images.unsplash.com/photo-1740657254989-42fe9c3b8cce',
    delay: 0.60,
  },
  {
    title: 'And Much More',
    image: 'https://images.unsplash.com/photo-1643553517154-24eb7fd86437',
    delay: 0.75,
  },
  {
    title: 'One-Time Cleaning',
    image: 'https://images.unsplash.com/photo-1581578731548-c64695cc6952',
    delay: 0.90,
  },
];

const testimonials = [
  {
    name: 'Ashley B.',
    quote: "Our office finally looks as polished as the work we do. The Flex team is reliable, detailed, and easy to communicate with.",
    business: 'Office Manager, Downtown Cleveland',
    direction: 'left' as const,
    delay: 0,
  },
  {
    name: 'Rick W.',
    quote: "They handle our facility with care and consistency. I never have to wonder whether the building will be ready for staff and visitors.",
    business: 'Facilities Director, Northeast Ohio',
    direction: 'right' as const,
    delay: 0.15,
  },
  {
    name: 'Maria S.',
    quote: "The difference is obvious after every visit. Our kitchen, dining room, and restrooms stay inspection-ready without us having to chase details.",
    business: 'Restaurant Owner, Lakewood OH',
    direction: 'left' as const,
    delay: 0.30,
  },
  {
    name: 'Travis M.',
    quote: "My shop's been spotless every two weeks straight, and they never touch my paperwork, which I actually appreciate. Been with them a while, not looking to switch anytime soon.",
    business: 'Auto Shop Owner, Westlake OH',
    direction: 'right' as const,
    delay: 0.45,
  },
];
---

<Layout
  title="Flex Commercial Services | Commercial Cleaning Cleveland, OH"
  description="Professional commercial cleaning in Cleveland, OH. Offices, restaurants, medical facilities, and more. Get a free quote today."
>
  <LoadingScreen />
  <Navbar />
  <Hero />

  <!-- ── SERVICES SECTION ─────────────────────────────────────────────── -->
  <section id="services" class="py-24 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-16">
        <h2 class="animate-on-scroll fade-up text-4xl md:text-5xl font-black text-white mb-5">
          What We Offer
        </h2>
        <p class="animate-on-scroll fade-up stagger-1 text-brand-muted text-lg max-w-2xl mx-auto leading-relaxed">
          Comprehensive cleaning solutions tailored to your industry, designed to protect your
          reputation and keep your team productive.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-14">
        {services.map((s, i) => (
          i === services.length - 1
            ? <div class="lg:col-start-2"><ServiceCard {...s} /></div>
            : <ServiceCard {...s} />
        ))}
      </div>

      <div class="animate-on-scroll fade-up text-center flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/services" class="btn-primary text-base px-8 py-4">Service Details</a>
        <a href="/booking"  class="btn-outline  text-base px-8 py-4">Book a Service</a>
      </div>

    </div>
  </section>

  <!-- ── ABOUT PREVIEW ────────────────────────────────────────────────── -->
  <section class="py-24 bg-brand-navy">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <div>
          <span class="animate-on-scroll fade-up text-brand-accent-dark text-sm font-semibold uppercase tracking-widest mb-3 block">
            About Flex
          </span>
          <h2 class="animate-on-scroll fade-up text-3xl md:text-4xl font-black text-white mb-6 leading-tight">
            Cleaning You Can Trust,<br />Results You'll Love
          </h2>
          <p class="animate-on-scroll fade-up text-brand-muted leading-relaxed mb-6">
            Flex Commercial Services brings top-tier commercial cleaning to Cleveland and all of Northeast Ohio.
          </p>
          <p class="animate-on-scroll fade-up text-brand-muted leading-relaxed mb-8">
            Founded by David George and Riley Hinkel, Flex was built by people who have done this work
            themselves, not a franchise operation. Every job gets that same personal attention to detail.
          </p>
          <div class="animate-on-scroll fade-up">
            <a href="/about" class="btn-primary">Meet the Team</a>
          </div>
        </div>

        <!-- Live stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-5">
          {[
            { target: 100, suffix: '+', label: 'Clients Served' },
            { target: 5,   suffix: '★', label: 'Average Rating' },
            { target: 3,   suffix: '+', label: 'Years Experience' },
          ].map((stat, i) => (
            <div class={`animate-on-scroll scale-in stagger-${i + 1} bg-[#1A1A1A] rounded-2xl p-6 border border-[#2e2e2e]`}>
              <p class="text-white text-3xl font-black stat-number">
                <span data-target={stat.target} data-suffix={stat.suffix}>{stat.target}{stat.suffix}</span>
              </p>
              <p class="text-brand-muted text-sm">{stat.label}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ── TESTIMONIALS SECTION ─────────────────────────────────────────── -->
  <section id="testimonials" style="background-color: #141414; padding: 4rem 0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-12">
        <h2 class="animate-on-scroll fade-up text-4xl md:text-5xl font-black text-white mb-5">
          A Proud Member of the Flex Family of Companies
        </h2>
        <p class="animate-on-scroll fade-up stagger-1 text-brand-muted text-lg max-w-xl mx-auto">
          Hear from the businesses we've transformed across Northeast Ohio.
        </p>
      </div>

      <!-- Flex Family of Companies logo -->
      <div class="animate-on-scroll fade-up text-center mb-14">
        <img
          src="https://assets.cdn.filesafe.space/jGKx4eTTbP1enXZEBWxm/media/69d2b4c73d829c73b24a6fa6.png"
          alt="Flex Family of Companies"
          width="800"
          height="400"
          style="filter: brightness(0) invert(1); display: block; width: 100%; height: auto; max-width: 500px; margin: 0 auto; overflow: visible;"
          loading="lazy"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map(t => <Testimonial {...t} />)}
      </div>

    </div>
  </section>

  <!-- ── FINAL CTA BAND ────────────────────────────────────────────────── -->
  <section class="py-20 bg-brand-accent">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="animate-on-scroll fade-up text-3xl md:text-4xl font-black text-white mb-4">
        Ready for a Spotless Space?
      </h2>
      <p class="animate-on-scroll fade-up stagger-1 text-white/80 mb-8 text-lg">
        Call us at <a href="tel:2168019686" class="font-bold underline underline-offset-4 hover:text-white transition-colors">(216)-801-9686</a> or get your free quote online today.
      </p>
      <div class="animate-on-scroll fade-up stagger-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/booking" class="bg-white text-brand-accent-dark font-bold px-9 py-4 rounded-lg hover:bg-red-50 transition-colors duration-200">
          Get a Free Quote
        </a>
        <a href="/services" class="btn-outline border-white/70">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollAnimations />
</Layout>
