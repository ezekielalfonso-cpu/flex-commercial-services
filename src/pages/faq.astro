---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';

const faqs = [
  {
    question: 'How often should I schedule commercial cleaning?',
    answer:
      "It depends on your industry and foot traffic. Most offices benefit from weekly or bi-weekly service, while restaurants and medical facilities typically require daily cleaning. We'll recommend a schedule based on your specific space during your free consultation.",
  },
  {
    question: 'Do you bring your own supplies and equipment?',
    answer:
      "Yes. Our team arrives fully equipped with professional-grade cleaning products, tools, and equipment. If you have preferences for specific products (fragrance-free, eco-friendly, etc.) just let us know and we'll accommodate.",
  },
  {
    question: 'Are you insured and bonded?',
    answer:
      'Absolutely. Flex Commercial Services is fully insured and bonded for your protection and peace of mind.',
  },
  {
    question: 'Do you offer contracts or is it month-to-month?',
    answer:
      "We offer both. We have flexible month-to-month arrangements as well as discounted contract pricing for clients who prefer a longer-term commitment. We'll find the structure that works best for your business.",
  },
  {
    question: 'What industries do you serve?',
    answer:
      'We serve a wide range of industries including offices, restaurants, fitness centers, schools, daycares, medical facilities, and more across Northeast Ohio.',
  },
  {
    question: 'How do I get a quote?',
    answer:
      "Simply fill out our booking form or call us at (216)-801-9686 and we'll get back to you within 24 hours with a customized quote for your space.",
  },
  {
    question: 'What makes Flex Commercial Services different from other cleaning companies?',
    answer:
      "We were built from the ground up by people who have done this work themselves — not a franchise operation. David and Riley started Flex because they saw how a truly professional clean could transform a business environment. Every job gets that same personal attention to detail.",
  },
  {
    question: 'Do you serve areas outside of Cleveland?',
    answer:
      'Yes. We serve the greater Northeast Ohio area including Lakewood, Parma, Strongsville, Beachwood, Solon, and surrounding communities. Contact us to confirm service availability in your area.',
  },
];
---

<Layout
  title="FAQ | Flex Commercial Services Cleveland, OH"
  description="Get answers to common questions about commercial cleaning services from Flex Commercial Services in Cleveland, OH."
>
  <Navbar />

  <!-- ── PAGE HERO ──────────────────────────────────────────────────────── -->
  <section
    class="pt-36 pb-20 text-center"
    style="background: linear-gradient(145deg, #0f1827 0%, #1a2744 50%, #0f1827 100%);"
  >
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="animate-on-scroll fade-up text-4xl sm:text-5xl md:text-6xl font-black text-white mb-5 leading-tight">
        Frequently Asked<br />
        <span class="text-blue-400">Questions</span>
      </h1>
      <p class="animate-on-scroll fade-up stagger-1 text-brand-muted text-lg leading-relaxed">
        Everything you need to know about working with Flex Commercial Services.
        Can't find your answer? Call us at&nbsp;
        <a href="tel:2168019686" class="text-blue-400 hover:text-blue-300 font-semibold transition-colors">
          (216)-801-9686
        </a>
      </p>
    </div>
  </section>

  <!-- ── FAQ ACCORDION ──────────────────────────────────────────────────── -->
  <section class="py-20 bg-brand-dark">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <FAQ items={faqs} />
    </div>
  </section>

  <!-- ── BOTTOM CTA ─────────────────────────────────────────────────────── -->
  <section class="py-20 bg-brand-navy">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="animate-on-scroll scale-in bg-[#1e3054] border border-[#2a3f6a] rounded-2xl p-10 md:p-14">
        <h2 class="text-3xl font-black text-white mb-3">Still Have Questions?</h2>
        <p class="text-brand-muted mb-8 leading-relaxed">
          Our team is happy to help. Call us at <a href="tel:2168019686" class="text-blue-400 hover:text-blue-300 font-semibold">(216)-801-9686</a> or get a free quote today — we respond within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/booking" class="btn-primary px-8 py-4 text-base">Get a Free Quote</a>
          <a href="tel:2168019686" class="btn-outline  px-8 py-4 text-base">Call Us Now</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollAnimations />
</Layout>
